<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Bonfire]*,[BonfireDB]*,[MoonCalendar]*</Include>
          <ExcludeByFile>**/obj/**,**/*.g.cs,**/*.g.i.cs,**/*.Designer.cs,**/*ModelSnapshot.cs</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
