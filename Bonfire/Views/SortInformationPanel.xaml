<UserControl x:Class="Bonfire.Views.SortInformationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CharacteristicValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,8,3" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Созревание" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=MaturityValue, Path=Visibility}" />
                <TextBlock x:Name="MaturityValue" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}"
                           Text="{Binding SelectedItem.Plant.PlantSort.Characteristics.Maturity, Converter={StaticResource OptionValue}}" />
                <TextBlock Grid.Row="1" Text="Вегетация, дн." FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=GrowingSeasonValue, Path=Visibility}" />
                <TextBlock x:Name="GrowingSeasonValue" Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.GrowingSeason"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MaxGrowingSeason"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="2" Text="Цвет" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=PlantColorValue, Path=Visibility}" />
                <TextBlock x:Name="PlantColorValue" Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}"
                           Text="{Binding SelectedItem.Plant.PlantSort.Characteristics.PlantColor, Converter={StaticResource OptionValue}}" />
                <TextBlock Grid.Row="3" Text="Высота, см" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=PlantHeightValue, Path=Visibility}" />
                <TextBlock x:Name="PlantHeightValue" Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.PlantHeight"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MaxPlantHeight"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="4" Text="Урожайность, кг" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=YieldKgValue, Path=Visibility}" />
                <TextBlock x:Name="YieldKgValue" Grid.Row="4" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}"
                           Text="{Binding SelectedItem.Plant.PlantSort.Characteristics.YieldKg, Converter={StaticResource OptionValue}, StringFormat=0.#, ConverterCulture=ru-RU}" />
                <TextBlock Grid.Row="5" Text="Масса плода, г" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=MinFruitWeightValue, Path=Visibility}" />
                <TextBlock x:Name="MinFruitWeightValue" Grid.Row="5" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MinFruitWeight"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MaxFruitWeight"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="6" Text="Размер плода, см" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=MinFruitSizeValue, Path=Visibility}" />
                <TextBlock x:Name="MinFruitSizeValue" Grid.Row="6" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MinFruitSize"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MaxFruitSize"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="7" Text="Возраст рассады, дн." FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=AgeOfSeedlingsValue, Path=Visibility}" />
                <TextBlock x:Name="AgeOfSeedlingsValue" Grid.Row="7" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.AgeOfSeedlings"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MaxAgeOfSeedlings"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="8" Text="Схема посадки, см" FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=LandingPatternValue, Path=Visibility}" />
                <TextBlock x:Name="LandingPatternValue" Grid.Row="8" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterParameter="x"
                                      ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.LandingPattern"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.LandingRowSpacing"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="9" Text="Срок прорастания, дн." FontWeight="DemiBold" Margin="0,3,8,3"
                           Visibility="{Binding ElementName=MinGerminationTimeValue, Path=Visibility}" />
                <TextBlock x:Name="MinGerminationTimeValue" Grid.Row="9" Grid.Column="1"
                           Style="{StaticResource CharacteristicValue}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource OptionalPair}" ConverterCulture="ru-RU">
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MinGerminationTime"
                                     Converter="{StaticResource OptionValue}" />
                            <Binding Path="SelectedItem.Plant.PlantSort.Characteristics.MaxGerminationTime"
                                     Converter="{StaticResource OptionValue}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
            <Grid Grid.Column="1" Margin="8,0,0,0"
                  Visibility="{Binding ElementName=DescriptionValue, Path=Visibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Описание сорта" FontWeight="DemiBold" Margin="5,3,0,5" />
                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" MinHeight="100">
                    <TextBlock x:Name="DescriptionValue" Style="{StaticResource CharacteristicValue}"
                               Text="{Binding SelectedItem.Plant.PlantSort.Characteristics.Description, Converter={StaticResource OptionValue}}"
                               Margin="5" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>