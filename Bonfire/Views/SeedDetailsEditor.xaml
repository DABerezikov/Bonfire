<UserControl x:Class="Bonfire.Views.SeedDetailsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:validation="clr-namespace:Bonfire.Infrastructure.Validation"
             Validation.Error="OnValidationError" Unloaded="OnUnloaded"
             IsEnabled="{Binding CanEditSeedDetails}">
    <UserControl.Resources>
        <Style x:Key="ValidationToolTipStyle" TargetType="Control">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource ValidationError}">
                                <Binding RelativeSource="{RelativeSource Self}" Path="(Validation.Errors)"/>
                                <Binding RelativeSource="{RelativeSource Self}" Path="(Validation.Errors).Count"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ValidationToolTipStyle}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ValidationToolTipStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DatePicker" BasedOn="{StaticResource ValidationToolTipStyle}"/>
        <Style TargetType="{x:Type primitives:DatePickerTextBox}" BasedOn="{StaticResource ValidationToolTipStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource SeedsBorderStyle}" CornerRadius="10" Padding="16" Margin="5,8" Width="1040">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="2" Width="210" ItemsSource="{Binding EditorOptions.Producers}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditedProducerId}"
                          ToolTip="Производитель для всех записей сорта"/>
                <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="8,0">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} - {1}">
                            <Binding Path="EditedItem.CultureName"/>
                            <Binding Path="EditedItem.SortName"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
            <UniformGrid Columns="8" Margin="0,0,0,14">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Источник семян" Margin="0,0,0,5"/>
                    <ComboBox SelectedValue="{Binding EditedItem.Package.SeedSource, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Куплено"/>
                        <ComboBoxItem Content="Собрано"/>
                        <ComboBoxItem Content="Подарено"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Дата покупки" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EditedItem.Package.PurchaseDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Вес в уп., г" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditedItem.Package.WeightPack, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Кол-во в уп., шт" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditedItem.Package.QuantityPack, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Срок годности" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EditedItem.Package.ExpirationDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Стоимость, руб." Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditedItem.Package.CostPack, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Остаток, шт" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditedItem.Package.AmountSeeds, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Остаток, г" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditedItem.Package.AmountSeedsWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                </StackPanel>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Созревание" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" IsEditable="True"
                              ItemsSource="{Binding EditorOptions.Maturities}" Text="{Binding SeedSortDetail.Maturity, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                    <TextBlock Grid.Row="1" Text="Вегетация, дн." VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SeedSortDetail.GrowingSeason, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                        <TextBlock Grid.Column="1" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedSortDetail.MaxGrowingSeason, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Цвет" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" IsEditable="True"
                              ItemsSource="{Binding EditorOptions.Colors}" Text="{Binding SeedSortDetail.PlantColor, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                    <TextBlock Grid.Row="3" Text="Высота, см" VerticalAlignment="Center"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SeedSortDetail.PlantHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                        <TextBlock Grid.Column="1" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedSortDetail.MaxPlantHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                    </Grid>
                    <TextBlock Grid.Row="4" Text="Урожайность, кг" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Language="ru-RU">
                        <TextBox.Text>
                            <Binding Path="SeedSortDetail.YieldKg" ConverterCulture="ru-RU" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnDataErrors="True" ValidatesOnExceptions="True" NotifyOnValidationError="True" TargetNullValue="">
                                <Binding.ValidationRules>
                                    <validation:OptionalNumberRule ValidationStep="RawProposedValue"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Grid.Row="5" Text="Масса плода, г" VerticalAlignment="Center"/>
                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SeedSortDetail.MinFruitWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                        <TextBlock Grid.Column="1" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedSortDetail.MaxFruitWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="Возраст рассады, дн." VerticalAlignment="Center"/>
                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SeedSortDetail.AgeOfSeedlings, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                        <TextBlock Grid.Column="1" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedSortDetail.MaxAgeOfSeedlings, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                    </Grid>
                    <TextBlock Grid.Row="7" Text="Схема посадки, см" VerticalAlignment="Center"/>
                    <Grid Grid.Row="7" Grid.Column="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SeedSortDetail.LandingPattern, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                        <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedSortDetail.LandingRowSpacing, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                    </Grid>
                    <TextBlock Grid.Row="8" Text="Срок прорастания, дн." VerticalAlignment="Center"/>
                    <Grid Grid.Row="8" Grid.Column="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SeedSortDetail.MinGerminationTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                        <TextBlock Grid.Column="1" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedSortDetail.MaxGerminationTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue=''}"/>
                    </Grid>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="85"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Примечание к упаковке" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" Text="{Binding EditedItem.Package.Note, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextAlignment="Left"/>
                    <TextBlock Grid.Row="2" Text="Описание сорта" Margin="0,12,0,5"/>
                    <TextBox Grid.Row="3" Text="{Binding SeedSortDetail.Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextAlignment="Left"/>
                </Grid>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Сохранить" Command="{Binding UpdateSeedsInfoCommand}" MinWidth="110" Padding="10,4" Margin="0,0,12,0"/>
                <Button Content="Удалить" Command="{Binding DeleteSeedCommand}" MinWidth="110" Padding="10,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
