<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Bonfire.Infrastructure.Converters">
    <BooleanToVisibilityConverter x:Key="PlanningBoolVisibility"/>
    <conv:ValidationErrorConverter x:Key="PlanningValidationError"/>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="0,2,6,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ToolTip">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource PlanningValidationError}">
                    <Binding RelativeSource="{RelativeSource Self}" Path="(Validation.Errors)"/>
                    <Binding RelativeSource="{RelativeSource Self}" Path="(Validation.HasError)"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="Margin" Value="0,2,6,5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Margin" Value="0,3,6,3"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="PlanningLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,8,5"/>
    </Style>
    <DataTemplate x:Key="PlanningPairTemplate">
        <TextBlock TextWrapping="Wrap">
            <TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="CultureName"/><Binding Path="SortName"/></MultiBinding></TextBlock.Text>
        </TextBlock>
    </DataTemplate>
</ResourceDictionary>
