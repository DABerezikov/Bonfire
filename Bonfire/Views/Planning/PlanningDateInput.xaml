<UserControl x:Class="Bonfire.Views.Planning.PlanningDateInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="ru-RU" MinHeight="29" Margin="0,2,6,5">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <TextBox x:Name="DateText" Margin="0" Padding="4,2" VerticalContentAlignment="Center"
                 ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <DatePicker x:Name="CalendarPicker" Grid.Column="1" Margin="0" Padding="0" BorderThickness="0"
                    ToolTip="Выбрать дату в календаре" SelectedDateChanged="CalendarDateChanged">
            <DatePicker.Resources>
                <Style TargetType="DatePickerTextBox"><Setter Property="Visibility" Value="Collapsed"/></Style>
            </DatePicker.Resources>
        </DatePicker>
    </Grid>
</UserControl>
