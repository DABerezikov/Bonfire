<UserControl xmlns:local="clr-namespace:Bonfire.Views.Planning" xmlns:p="clr-namespace:Bonfire.Models.Planning" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:fa5="http://schemas.fontawesome.com/icons/" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Bonfire.Views.Planning.PlantingPlanningView" Language="ru-RU">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PlanningStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Padding="8" Margin="0,8,0,0" Background="#F1F5EE">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Сезонные планы посадок" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                            <Binding Path="SeasonYear" />
                                            <Binding Path="Name" />
                                            <Binding Path="RegionName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel>
                        <Button Command="{Binding LoadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_SyncAlt" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Обновить" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeletePlanCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Trash" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Удалить план" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <WrapPanel Margin="0,5,0,8">
                        <Button Command="{Binding NewBatchCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Plus" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Добавить партию" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteBatchCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Trash" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Удалить партию" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <Expander DockPanel.Dock="Bottom" Header="Создать сезонный план" Margin="0,8,6,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Название *" TextWrapping="Wrap" />
                        <TextBox Text="{Binding NewPlanName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Год сезона *" TextWrapping="Wrap" />
                        <TextBox Text="{Binding NewPlanYear, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Регион *" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding NewPlanRegion}" DisplayMemberPath="Definition.Name.Value" />
                        <Button Command="{Binding CreatePlanCommand}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Plus" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Создать план" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Expander>
                <ListBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="0,0,6,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5" BorderBrush="#DDE5D7" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Method" />
                                                <Binding Path="Place" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Растения: {0}; семена: {1}">
                                                <Binding Path="Plants" />
                                                <Binding Path="Seeds" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Sowing, StringFormat=Посев: {0}}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#E1E5DD" />
            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Плановая партия" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="* — обязательные поля выбранного режима. Данные сохраняются при переходе между шагами." TextWrapping="Wrap" Foreground="#666666" Margin="0,5,0,5" />
                    <WrapPanel>
                        <Button Command="{Binding CancelCommand}" ToolTip="Вернуть сохранённые значения партии">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_Undo" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Отменить изменения" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Border Background="#F1F5EE" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding StepTitle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="PlanningStepGuidance" Text="{Binding StepGuidance}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,5,0,0">
                        <Button Command="{Binding PreviousStepCommand}">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_ArrowLeft" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Назад" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NextStepCommand}" Visibility="{Binding HasNextStep, Converter={StaticResource PlanningBoolVisibility}}" ToolTip="{Binding StepGuidance}" ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <fa5:ImageAwesome Icon="Solid_ArrowRight" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                <TextBlock Text="Далее" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <TabControl SelectedIndex="{Binding EditorStep}" IsEnabled="{Binding EditorAvailable}" x:Name="PlanningSteps">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel>
                                <fa5:ImageAwesome Icon="Solid_Seedling" Height="14" Margin="0,2,0,4" Foreground="#388E3C" />
                                <TextBlock Text="1. Культура" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,10,8,10">
                                <TextBlock Text="Культура / сорт *" TextWrapping="Wrap" />
                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Draft.Choice, ValidatesOnDataErrors=True}" ItemTemplate="{StaticResource PlanningPairTemplate}" />
                                <CheckBox Content="Прямой посев на место" IsChecked="{Binding Draft.DirectSow}" Margin="0,5,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Место выращивания *" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="Размещение *" TextWrapping="Wrap" />
                                    <ComboBox Grid.Row="1" ItemsSource="{x:Static p:PlanningLookups.Locations}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Draft.Location, ValidatesOnDataErrors=True}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static p:PlanningLookups.Placements}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Draft.Placement, ValidatesOnDataErrors=True}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem IsEnabled="{Binding DatesStepEnabled}">
                        <TabItem.Header>
                            <StackPanel>
                                <fa5:ImageAwesome Icon="Solid_CalendarAlt" Height="14" Margin="0,2,0,4" Foreground="#388E3C" />
                                <TextBlock Text="2. Сроки" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,10,8,10">
                                <TextBlock Text="{Binding Draft.WindowLabel}" FontWeight="SemiBold" Margin="0,8,0,2" />
                                <TextBlock Text="Обязательный интервал: начало не позже окончания. Обе границы включены." Foreground="#666666" TextWrapping="Wrap" />
                                <Grid Visibility="{Binding Draft.IsSeedling, Converter={StaticResource PlanningBoolVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Начало периода *" />
                                        <local:PlanningDateInput x:Name="PlanningStartInput" Text="{Binding Draft.TransplantStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" ToolTip="Начало периода: выберите дату в календаре или введите дд.мм.гггг" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Окончание периода *" />
                                        <local:PlanningDateInput x:Name="PlanningEndInput" Text="{Binding Draft.TransplantEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" ToolTip="Окончание периода: выберите дату в календаре или введите дд.мм.гггг" />
                                    </StackPanel>
                                </Grid>
                                <Grid Visibility="{Binding Draft.DirectSow, Converter={StaticResource PlanningBoolVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Начало периода *" />
                                        <local:PlanningDateInput Text="{Binding Draft.DirectStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" ToolTip="Начало периода: выберите дату в календаре или введите дд.мм.гггг" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Окончание периода *" />
                                        <local:PlanningDateInput Text="{Binding Draft.DirectEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" ToolTip="Окончание периода: выберите дату в календаре или введите дд.мм.гггг" />
                                    </StackPanel>
                                </Grid>
                                <GroupBox Header="Региональная справка" Margin="0,5,0,8" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReferenceText}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                        <ItemsControl ItemsSource="{Binding References}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4,0,4">
                                                        <Button DockPanel.Dock="Right" Command="{Binding DataContext.UseReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <fa5:ImageAwesome Icon="Solid_CalendarAlt" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                                                <TextBlock Text="Использовать интервал" />
                                                            </StackPanel>
                                                        </Button>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="#666666" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Text="Ручные даты необязательны: оставьте пустыми для расчёта." TextWrapping="Wrap" Margin="0,4,0,6" />
                                <GroupBox Header="Ручной выбор дат" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Выбранный день посева" />
                                        <TextBlock Grid.Column="1" Text="Выбранный день высадки" Visibility="{Binding Draft.IsSeedling, Converter={StaticResource PlanningBoolVisibility}}" />
                                        <local:PlanningDateInput x:Name="PlanningSowingInput" Grid.Row="1" Text="{Binding Draft.ChosenSowingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                        <local:PlanningDateInput Grid.Row="1" Grid.Column="1" Text="{Binding Draft.ChosenTransplantText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Visibility="{Binding Draft.IsSeedling, Converter={StaticResource PlanningBoolVisibility}}" />
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem IsEnabled="{Binding QuantityStepEnabled}">
                        <TabItem.Header>
                            <StackPanel>
                                <fa5:ImageAwesome Icon="Solid_ThLarge" Height="14" Margin="0,2,0,4" Foreground="#388E3C" />
                                <TextBlock Text="3. Количество" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,10,8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Количество растений * (при ручном режиме)" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="Семена вручную (пусто — расчёт)" TextWrapping="Wrap" />
                                    <TextBox x:Name="PlanningTargetInput" Grid.Row="1" IsEnabled="{Binding Draft.Harvest.IsManualPlants}" Text="{Binding Draft.TargetPlantsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.ManualSeedCountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                                </Grid>
                                <Expander Header="Грядка, вместимость и урожай, кг" Margin="0,8,0,6" IsExpanded="True">
                                    <StackPanel>
                                        <TextBlock Text="Режим количества растений" />
                                        <ComboBox ItemsSource="{x:Static p:PlanningLookups.HarvestModes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Draft.Harvest.Mode}" />
                                        <ComboBox ItemsSource="{Binding Beds}" SelectedItem="{Binding SelectedBed}" DisplayMemberPath="Name" />
                                        <Button Command="{Binding UseBedCommand}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <fa5:ImageAwesome Icon="Solid_RulerCombined" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                                <TextBlock Text="Взять размеры выбранной грядки" />
                                            </StackPanel>
                                        </Button>
                                        <local:HarvestPlanningEditor DataContext="{Binding Draft.Harvest}" />
                                        <Button Command="{Binding UseSortSpacingCommand}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <fa5:ImageAwesome Icon="Solid_ThLarge" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                                <TextBlock Text="Взять шаги из схемы сорта (см → м)" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding HalfMarginsCommand}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <fa5:ImageAwesome Icon="Solid_ArrowsAltH" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                                <TextBlock Text="Отступы по половине шага" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="Снимок прямоугольника партии. Совместимость размещения нескольких партий на общей грядке не проверяется; сетка грядки не меняется." TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SeasonHarvestText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem IsEnabled="{Binding ParametersStepEnabled}">
                        <TabItem.Header>
                            <StackPanel>
                                <fa5:ImageAwesome Icon="Solid_SlidersH" Height="14" Margin="0,2,0,4" Foreground="#388E3C" />
                                <TextBlock Text="4. Параметры" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,10,8,10">
                                <TextBlock Text="Для расчёта нужны прорастание и, для рассады, возраст от всходов: из сорта, культуры или указанные здесь. Для автоматического количества семян задайте всхожесть и потери; либо введите семена вручную на предыдущем шаге." TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Expander Header="Параметры партии: пустые поля наследуются из справочника" Margin="0,8,0,6" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,0">
                                        <local:GrowingProfileEditor DataContext="{Binding Draft.Profile}" />
                                        <TextBlock Text="Предел поиска лунного сдвига, дней в каждую сторону" />
                                        <TextBox Text="{Binding Draft.SearchLimitText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" MaxWidth="180" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem IsEnabled="{Binding ResultStepEnabled}">
                        <TabItem.Header>
                            <StackPanel>
                                <fa5:ImageAwesome Icon="Solid_Calculator" Height="14" Margin="0,2,0,4" Foreground="#388E3C" />
                                <TextBlock Text="5. Результат" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10,10,8,10">
                                <TextBlock Text="{Binding CalculationGuidance}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Command="{Binding CalculateCommand}" ToolTip="{Binding CalculationGuidance}" ToolTipService.ShowOnDisabled="True">
                                        <StackPanel Orientation="Horizontal">
                                            <fa5:ImageAwesome Icon="Solid_Calculator" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                            <TextBlock Text="Рассчитать / пересчитать" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveCommand}" ToolTip="{Binding SaveGuidance}" ToolTipService.ShowOnDisabled="True">
                                        <StackPanel Orientation="Horizontal">
                                            <fa5:ImageAwesome Icon="Solid_Save" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                            <TextBlock Text="Сохранить партию" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <CheckBox Content="Сохранить по прежней справке, если источник изменился после расчёта" IsChecked="{Binding AcceptHistoricalSnapshot}" Margin="0,3,0,10" />
                                <TextBlock Text="Сроки и прогноз" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="PlanningPreviewText" Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                                <ItemsControl ItemsSource="{Binding Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDE5D7" BorderThickness="0,0,0,1" Padding="0,5">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Command="{Binding DataContext.ChooseSowingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <fa5:ImageAwesome Icon="Solid_Seedling" Height="12" Margin="0,0,6,0" Foreground="#388E3C" />
                                                            <TextBlock Text="Выбрать посев" />
                                                        </StackPanel>
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
