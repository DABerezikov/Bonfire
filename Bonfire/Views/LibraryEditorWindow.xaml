<UserControl x:Class="Bonfire.Views.LibraryEditorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Bonfire.ViewModels"
             xmlns:libraries="clr-namespace:Bonfire.Domain.Libraries;assembly=Bonfire.Domain"
             xmlns:m="clr-namespace:Bonfire.Models"
             xmlns:planning="clr-namespace:Bonfire.Views.Planning"
             d:DataContext="{d:DesignInstance {x:Type vm:LibraryEditorViewModel}}"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <TabControl>
        <TabItem Header="Культуры, сорта и производители">
            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LibraryBorderStyle}" />
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource LibraryBorderStyle}" />
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource LibraryBorderStyle}" />

                <!-- Список сортов -->
                <DataGrid Grid.Column="0" Grid.Row="0" IsReadOnly="True" SelectionMode="Single"
                          ItemsSource="{Binding Sort}" Margin="15"
                          ColumnHeaderStyle="{StaticResource CenterGridHeaderStyle}"
                          SelectedItem="{Binding SelectedSort}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Библиотека сортов" Style="{StaticResource LibraryTextBlockStyle}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:SortFromSeedsViewModel}">
                                    <TextBlock Text="{Binding Name}" Padding="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Список культур -->
                <DataGrid Grid.Column="1" Grid.Row="0" IsReadOnly="True" SelectionMode="Single"
                          ItemsSource="{Binding Culture}" Margin="15"
                          ColumnHeaderStyle="{StaticResource CenterGridHeaderStyle}"
                          SelectedItem="{Binding SelectedCulture}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Библиотека культур" Style="{StaticResource LibraryTextBlockStyle}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:CultureFromViewModel}">
                                    <TextBlock Text="{Binding Name}" Padding="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Список производителей -->
                <DataGrid Grid.Column="2" Grid.Row="0" IsReadOnly="True" SelectionMode="Single"
                          ItemsSource="{Binding Producer}" Margin="15"
                          ColumnHeaderStyle="{StaticResource CenterGridHeaderStyle}"
                          SelectedItem="{Binding SelectedProducer}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Библиотека производителей"
                                           Style="{StaticResource LibraryTextBlockStyle}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:ProducerFromViewModel}">
                                    <TextBlock Text="{Binding Name}" Padding="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Единое оформление нижних редакторов. -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="5,0,5,5">
                    <StackPanel.Resources>
                        <Style x:Key="EditorBorderStyle" TargetType="Border">
                            <Setter Property="BorderBrush" Value="Gray" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Padding" Value="10,8" />
                        </Style>
                        <Style x:Key="EditorLabelStyle" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,3,6,3" />
                        </Style>
                        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Margin" Value="0,3,16,3" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="EditorComboBoxStyle" TargetType="ComboBox">
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Margin" Value="0,3,16,3" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="EditorButtonStyle" TargetType="Button">
                            <Setter Property="MinWidth" Value="90" />
                            <Setter Property="Height" Value="26" />
                        </Style>
                    </StackPanel.Resources>

                    <Border Style="{StaticResource EditorBorderStyle}"
                            Visibility="{Binding SortDetail, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название:" Style="{StaticResource EditorLabelStyle}" />
                            <TextBox Grid.Column="1" Style="{StaticResource EditorTextBoxStyle}"
                                     Text="{Binding SortDetail.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <TextBlock Grid.Column="2" Text="Культура:" Style="{StaticResource EditorLabelStyle}" />
                            <ComboBox Grid.Column="3" Style="{StaticResource EditorComboBoxStyle}"
                                      ItemsSource="{Binding Culture}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding SortDetail.CultureId}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,3">
                                <Button Content="Сохранить" Command="{Binding SaveSortCommand}"
                                        Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Отмена" Command="{Binding CancelSortCommand}"
                                        Style="{StaticResource EditorButtonStyle}" />
                                <Button Content="Удалить" Command="{Binding DeleteSortCommand}" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EditorBorderStyle}"
                            Visibility="{Binding CultureDetail, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название:" Style="{StaticResource EditorLabelStyle}" />
                            <TextBox Grid.Column="1" Style="{StaticResource EditorTextBoxStyle}"
                                     Text="{Binding CultureDetail.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <TextBlock Grid.Column="2" Text="Класс:" Style="{StaticResource EditorLabelStyle}" />
                            <ComboBox Grid.Column="3" Style="{StaticResource EditorComboBoxStyle}"
                                      ItemsSource="{Binding ClassList}" SelectedItem="{Binding CultureDetail.Class}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,3">
                                <Button Content="Сохранить" Command="{Binding SaveCultureCommand}"
                                        Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Отмена" Command="{Binding CancelCultureCommand}"
                                        Style="{StaticResource EditorButtonStyle}" />
                                <Button Content="Удалить" Command="{Binding DeleteCultureCommand}" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource EditorBorderStyle}"
                            Visibility="{Binding SelectedProducer, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название:" Style="{StaticResource EditorLabelStyle}" />
                            <TextBox Grid.Column="1" Style="{StaticResource EditorTextBoxStyle}"
                                     Text="{Binding ProducerDetailName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,3">
                                <Button Content="Сохранить" Command="{Binding SaveProducerCommand}"
                                        Style="{StaticResource EditorButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Отмена" Command="{Binding CancelProducerCommand}"
                                        Style="{StaticResource EditorButtonStyle}" />
                                <Button Content="Удалить" Command="{Binding DeleteProducerCommand}" Style="{StaticResource EditorButtonStyle}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

            </Grid>
        </TabItem>
        <TabItem Header="Цвета и сроки созревания">
            <Grid DataContext="{Binding SortOptions}" Margin="16" IsEnabled="{Binding IsEditable}">
                <i:Interaction.Triggers><i:EventTrigger EventName="Loaded"><i:InvokeCommandAction Command="{Binding EnsureLoadedCommand}"/></i:EventTrigger></i:Interaction.Triggers>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Category}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <ComboBoxItem Content="Цвета" Tag="{x:Static libraries:SortOptionCategory.Color}"/>
                    <ComboBoxItem Content="Сроки созревания" Tag="{x:Static libraries:SortOptionCategory.Maturity}"/>
                </ComboBox>
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single">
                    <DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Используется в сортах" Binding="{Binding IsUsed}"/></DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="{Binding NameRule.Caption}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,4,0,8" HorizontalScrollBarVisibility="Auto"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить новое" Command="{Binding NewCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Обновить" Command="{Binding LoadCommand}" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Планирование: регионы и агропрофили">
            <planning:PlanningLibrariesView DataContext="{Binding PlanningLibraries}" />
        </TabItem>
    </TabControl>
</UserControl>
