<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление Bonfire" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="24">
        <TextBlock Text="Доступна новая версия Bonfire" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Version}" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Destination}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="Перед обновлением Bonfire будет закрыт. Сохраните нужные изменения: несохранённый ввод может быть потерян. Затем будет создана резервная копия и заменены файлы приложения. База данных сохранится." />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Если вы не готовы или не ответите вовремя, обновление отменится. Приложение можно будет обновить следующим запуском workflow." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Approve" Content="Закрыть и обновить" Padding="14,7" Margin="0,0,10,0" />
            <Button Content="Отложить" IsCancel="True" IsDefault="True" Padding="14,7" />
        </StackPanel>
    </StackPanel>
</Window>
